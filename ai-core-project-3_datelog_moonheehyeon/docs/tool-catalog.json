[
  {
    "name": "search_movies",
    "description": "불완전한 영화 제목이나 출연자 이름으로 KOBIS 영화 목록·필모그래피를 검색해 사용자에게 확인할 후보를 찾는다.",
    "tool_type": "external_api",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "$defs": {
        "MovieMatch": {
          "properties": {
            "movie_cd": {
              "pattern": "^\\d{8}$",
              "title": "Movie Cd",
              "type": "string"
            },
            "movie_nm": {
              "minLength": 1,
              "title": "Movie Nm",
              "type": "string"
            },
            "year": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Year"
            },
            "open_date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Open Date"
            }
          },
          "required": [
            "movie_cd",
            "movie_nm"
          ],
          "title": "MovieMatch",
          "type": "object"
        },
        "MovieMatches": {
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/MovieMatch"
              },
              "title": "Items",
              "type": "array"
            },
            "source": {
              "default": "KOBIS 영화 목록·영화인 필모그래피",
              "title": "Source",
              "type": "string"
            },
            "warnings": {
              "items": {
                "type": "string"
              },
              "title": "Warnings",
              "type": "array"
            }
          },
          "required": [
            "items"
          ],
          "title": "MovieMatches",
          "type": "object"
        },
        "ToolError": {
          "properties": {
            "code": {
              "enum": [
                "BAD_ARGUMENT",
                "INVALID_KEY",
                "NOT_FOUND",
                "NO_DATA",
                "NO_RUNTIME",
                "UPSTREAM_ERROR",
                "ACCESS_DENIED",
                "TIMEOUT",
                "CONNECTION_ERROR"
              ],
              "title": "Code",
              "type": "string"
            },
            "message": {
              "title": "Message",
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "ToolError",
          "type": "object"
        },
        "ToolFailure": {
          "properties": {
            "ok": {
              "const": false,
              "title": "Ok",
              "type": "boolean"
            },
            "error": {
              "$ref": "#/$defs/ToolError"
            }
          },
          "required": [
            "ok",
            "error"
          ],
          "title": "ToolFailure",
          "type": "object"
        },
        "ToolSuccess_MovieMatches_": {
          "properties": {
            "ok": {
              "const": true,
              "title": "Ok",
              "type": "boolean"
            },
            "data": {
              "$ref": "#/$defs/MovieMatches"
            }
          },
          "required": [
            "ok",
            "data"
          ],
          "title": "ToolSuccess[MovieMatches]",
          "type": "object"
        }
      },
      "anyOf": [
        {
          "$ref": "#/$defs/ToolSuccess_MovieMatches_"
        },
        {
          "$ref": "#/$defs/ToolFailure"
        }
      ]
    }
  },
  {
    "name": "search_places",
    "description": "선택한 영화관·식당 또는 기억한 지역 주변의 실제 식당/카페를 카카오에서 검색한다. 평점·영업시간·가격을 생성하지 않는다.",
    "tool_type": "external_api",
    "parameters": {
      "type": "object",
      "properties": {
        "region": {
          "type": "string"
        },
        "kind": {
