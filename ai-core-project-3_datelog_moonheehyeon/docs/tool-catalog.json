  {
    "name": "get_showtimes",
    "description": "영화명·지역·날짜의 실제 CGV·롯데시네마·메가박스 회차와 잔여석을 통합 조회한다. KOBIS 영화코드는 사용하지 않는다.",
    "tool_type": "external_api",
    "parameters": {
      "type": "object",
      "properties": {
        "region": {
          "type": "string"
        },
        "movie_nm": {
          "type": "string"
        },
        "watch_date": {
          "type": "string",
          "description": "YYYY-MM-DD"
        },
        "start_time": {
          "type": "string",
          "description": "HH:MM, 이 시각 포함 이후"
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadline_inclusive": {
          "type": "boolean",
          "description": "까지=true, 전에/이전=false"
        },
        "buffer_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 240
        },
        "brands": {
          "type": "array",
          "items": {
            "enum": [
              "cgv",
              "lotte",
              "megabox"
            ]
          },
          "minItems": 1,
          "maxItems": 3
        }
      },
      "required": [
        "region",
        "movie_nm",
        "watch_date"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "$defs": {
        "Showtime": {
          "properties": {
            "schedule_id": {
              "title": "Schedule Id",
              "type": "string"
            },
            "brand": {
              "default": "cgv",
              "enum": [
                "cgv",
                "lotte",
                "megabox"
              ],
              "title": "Brand",
              "type": "string"
            },
            "brand_name": {
              "default": "CGV",
              "title": "Brand Name",
              "type": "string"
            },
            "movie_nm": {
              "title": "Movie Nm",
              "type": "string"
            },
            "movie_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Movie Id"
            },
            "cgv_movie_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Cgv Movie Id"
            },
            "cinema": {
              "title": "Cinema",
