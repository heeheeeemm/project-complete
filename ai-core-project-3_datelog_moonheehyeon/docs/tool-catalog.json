              ],
              "default": null,
              "title": "Phone"
            },
            "url": {
              "title": "Url",
              "type": "string"
            },
            "lat": {
              "maximum": 90,
              "minimum": -90,
              "title": "Lat",
              "type": "number"
            },
            "lng": {
              "maximum": 180,
              "minimum": -180,
              "title": "Lng",
              "type": "number"
            },
            "distance_m": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Distance M"
            }
          },
          "required": [
            "id",
            "name",
            "category",
            "address",
            "url",
            "lat",
            "lng"
          ],
          "title": "Place",
          "type": "object"
        },
        "PlaceData": {
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/Place"
              },
              "title": "Items",
              "type": "array"
            },
            "kind": {
              "enum": [
                "restaurant",
                "cafe",
                "place"
              ],
              "title": "Kind",
              "type": "string"
            },
            "region": {
              "title": "Region",
              "type": "string"
            },
            "cuisine": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Cuisine"
            },
            "anchor": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Anchor"
            },
            "checked_at": {
              "format": "date-time",
              "title": "Checked At",
              "type": "string"
            },
            "source": {
              "default": "카카오 로컬",
              "title": "Source",
              "type": "string"
            },
            "notice": {
              "default": "메뉴·영업시간·가격은 카카오맵 장소 상세에서 확인해 주세요.",
              "title": "Notice",
              "type": "string"
            }
          },
          "required": [
            "items",
            "kind",
            "region",
            "checked_at"
          ],
          "title": "PlaceData",
          "type": "object"
        },
        "ToolError": {
          "properties": {
            "code": {
              "enum": [
                "BAD_ARGUMENT",
                "INVALID_KEY",
                "NOT_FOUND",
                "NO_DATA",
                "NO_RUNTIME",
                "UPSTREAM_ERROR",
                "ACCESS_DENIED",
                "TIMEOUT",
                "CONNECTION_ERROR"
              ],
              "title": "Code",
              "type": "string"
            },
            "message": {
              "title": "Message",
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "ToolError",
          "type": "object"
        },
        "ToolFailure": {
          "properties": {
            "ok": {
              "const": false,
              "title": "Ok",
              "type": "boolean"
            },
            "error": {
              "$ref": "#/$defs/ToolError"
            }
          },
          "required": [
            "ok",
            "error"
          ],
          "title": "ToolFailure",
          "type": "object"
        },
        "ToolSuccess_PlaceData_": {
          "properties": {
            "ok": {
              "const": true,
              "title": "Ok",
              "type": "boolean"
            },
            "data": {
              "$ref": "#/$defs/PlaceData"
            }
          },
          "required": [
            "ok",
            "data"
          ],
          "title": "ToolSuccess[PlaceData]",
          "type": "object"
        }
      },
      "anyOf": [
        {
          "$ref": "#/$defs/ToolSuccess_PlaceData_"
        },
        {
          "$ref": "#/$defs/ToolFailure"
        }
      ]
    }
